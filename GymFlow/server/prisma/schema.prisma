generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
  TRAINER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum AttendanceMethod {
  FACE
  MANUAL
  ASSISTED
}

enum NoShowStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum FollowUpOutcome {
  WILL_RETURN
  INJURED
  TRAVELLING
  TIMING_ISSUE
  UNHAPPY
  NO_RESPONSE
  CANCELLED
}

enum RenewalOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum ExpenseCategory {
  RENT
  SALARIES
  EQUIPMENT
  UTILITIES
  MARKETING
  OTHER
}

enum ClassBookingStatus {
  BOOKED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  PAYMENT
  RENEWAL
  ATTENDANCE
  SYSTEM
}

model RenewalOrder {
  id           Int               @id @default(autoincrement())
  gymId        Int
  memberId     Int
  membershipId Int
  kind         String            @default("RENEWAL")
  amount       Decimal           @db.Decimal(10, 2)
  status       RenewalOrderStatus @default(PENDING)
  provider     String?
  providerOrderId String?        @unique
  expiresAt    DateTime?
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payments   Payment[]
  invoice    Invoice?

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id                Int           @id @default(autoincrement())
  gymId             Int
  memberId          Int
  renewalOrderId    Int
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerPaymentId String?       @unique
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  renewalOrder RenewalOrder @relation(fields: [renewalOrderId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([renewalOrderId])
  @@index([status])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  gymId          Int
  memberId       Int
  renewalOrderId Int           @unique
  invoiceNumber  String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  renewalOrder RenewalOrder @relation(fields: [renewalOrderId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@index([dueDate])
}

model RenewalReminder {
  id           Int      @id @default(autoincrement())
  gymId        Int
  memberId     Int
  membershipId Int
  reminderType String
  sentAt       DateTime @default(now())

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, reminderType])
  @@index([gymId])
  @@index([memberId])
}

model Gym {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  primaryColor String? @default("#6d63ff")
  accentColor String? @default("#111827")
  theme String @default("violet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  users        User[]
  members      Member[]
  plans        Plan[]
  memberships  Membership[]
  attendances  Attendance[]
  noShowCases  NoShowCase[]
  followUps    FollowUp[]
  renewalOrders RenewalOrder[]
  payments      Payment[]
  invoices      Invoice[]
  reminderLogs  RenewalReminder[]
  expenses      Expense[]
  classes       GymClass[]
  notifications Notification[]
}

model User {
  id           Int      @id @default(autoincrement())
  gymId        Int?
  name         String
  email        String   @unique
  passwordHash String   @default("")
  role         UserRole @default(OWNER)
  phone        String?
  isActive     Boolean  @default(true)
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  resetTokenHash String?
  resetExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym Gym? @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classes GymClass[]

  @@index([gymId])
}

model Member {
  id        Int      @id @default(autoincrement())
  gymId     Int
  name      String
  email     String?
  phone     String?
  faceDescriptor Json?
  portalPasswordHash String?
  portalInviteHash String?
  portalInviteExpiresAt DateTime?
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  attendances  Attendance[]
  noShowCases  NoShowCase[]
  followUps    FollowUp[]
  renewalOrders RenewalOrder[]
  payments      Payment[]
  invoices      Invoice[]
  reminderLogs  RenewalReminder[]
  classBookings ClassBooking[]
  notifications Notification[]

  @@index([gymId])
  @@index([phone])
}

model Plan {
  id           Int      @id @default(autoincrement())
  gymId        Int
  name         String
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([gymId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  gymId       Int
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(10, 2)
  expenseDate DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@index([gymId])
  @@index([expenseDate])
}

model GymClass {
  id          Int            @id @default(autoincrement())
  gymId       Int
  trainerId   Int?
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int            @default(20)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer     User?          @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  bookings    ClassBooking[]
  @@index([gymId, startsAt])
  @@index([trainerId])
}

model ClassBooking {
  id        Int                @id @default(autoincrement())
  classId   Int
  memberId  Int
  status    ClassBookingStatus @default(BOOKED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  class     GymClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([classId, memberId])
  @@index([memberId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  gymId     Int
  memberId  Int?
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([gymId, isRead])
  @@index([createdAt])
}

model Membership {
  id        Int              @id @default(autoincrement())
  gymId     Int
  memberId  Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  attendances Attendance[]
  renewalOrders RenewalOrder[]
  reminderLogs  RenewalReminder[]

  @@index([gymId])
  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model Attendance {
  id             Int              @id @default(autoincrement())
  gymId          Int
  memberId       Int
  membershipId   Int
  checkedInAt    DateTime         @default(now())
  method         AttendanceMethod @default(MANUAL)
  assistedReason String?

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([checkedInAt])
}

model NoShowCase {
  id             Int          @id @default(autoincrement())
  gymId          Int
  memberId       Int
  detectedAt     DateTime     @default(now())
  lastAttendance DateTime?
  inactiveDays   Int
  status         NoShowStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  followUps  FollowUp[]

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@index([detectedAt])
}

model FollowUp {
  id           Int            @id @default(autoincrement())
  gymId        Int
  noShowCaseId Int
  memberId     Int
  outcome      FollowUpOutcome
  notes        String?
  nextActionAt DateTime?
  createdAt    DateTime       @default(now())

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  noShowCase NoShowCase @relation(fields: [noShowCaseId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([noShowCaseId])
  @@index([memberId])
  @@index([nextActionAt])
}
